[Desktop Entry]
# Overrides /etc/xdg/autostart/org.fcitx.Fcitx5.desktop -- a file of the same
# name in ~/.config/autostart takes precedence, so this is the whole entry.
#
# The only change is `--disable=notificationitem`, which stops fcitx5 from
# registering a Status Notifier item, i.e. the language-picker icon in
# waybar's tray. waybar's tray module has no per-item ignore list, so the
# icon has to be switched off at the source.
#
# Note: putting `Enabled=False` in ~/.config/fcitx5/addon/notificationitem.conf
# does NOT work -- fcitx5 kept loading the addon anyway. The CLI flag is what
# actually takes effect.
#
# Input switching is unaffected: SUPER+Space still cycles keyboard-us, pinyin
# and mozc, and fcitx5-configtool still works.
Name=Fcitx 5
GenericName=Input Method
Comment=Start Input Method
Exec=/usr/bin/fcitx5 --disable=notificationitem
Icon=fcitx
Terminal=false
Type=Application
Categories=System;Utility;
StartupNotify=false
X-GNOME-AutoRestart=false
X-GNOME-Autostart-Notify=false
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true

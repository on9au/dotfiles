# Sourced by uwsm into the graphical session environment, before the
# compositor and before anything XDG-autostarted.
#
# This is the right place for input-method variables rather than hl.env() in
# hypr/env.lua: hl.env only reaches processes Hyprland itself spawns, and
# fcitx5 is started by systemd via XDG autostart
# (/etc/xdg/autostart/org.fcitx.Fcitx5.desktop), not by the compositor.
#
# Shell syntax. Applied at login -- edits need a re-login to take effect.
#
# This file is a chezmoi template (source: uwsm/env.tmpl) because two of the
# variables at the bottom are per-machine and one of them, AQ_DRM_DEVICES,
# would stop the compositor starting at all on the wrong machine.

# ---- sudo password prompts outside a terminal ----
#
# sudo reads the password from the terminal when there is one. With this set it
# falls back to a graphical prompt when there is *no* tty -- a GUI app, a
# script run from a launcher, or a command sent by a tool that has no terminal
# attached. Without it those just fail with "a terminal is required".
#
# ksshaskpass is Qt6, so it picks up the qt6ct theming rather than looking like
# a 1998 X11 dialog. Requires: pacman -S ksshaskpass
#
# Note this means anything running in your session can trigger a password
# prompt on screen; that is the same trade-off polkit already makes, but it is
# a real one. Comment this out to go back to terminal-only prompts.
export SUDO_ASKPASS=/usr/bin/ksshaskpass

# ---- Qt / KDE app theming ----
#
# Do NOT set QT_QPA_PLATFORMTHEME=kde here. It themes Dolphin correctly, but
# outside a Plasma session it also breaks opening files: KIO stops resolving
# the default application and puts up an "Open With" dialog that lists nothing
# and cannot be dismissed into anything. Measured, not guessed --
# `kde-open <image>` fails 3/3 with it set and succeeds 4/4 without.
#
# qt6ct is a platform theme too, but not KDE's, and it was checked against the
# same test: it opens files 3/3 where `kde` managed 0/3. It gives back the
# things a bare Qt style cannot set -- icon theme, fonts, dialog behaviour --
# and is configured in ~/.config/qt6ct/qt6ct.conf (GUI: `qt6ct`).
export QT_QPA_PLATFORMTHEME=qt6ct

# No QT_STYLE_OVERRIDE here on purpose: it would win over qt6ct's own style
# setting and make the style dropdown in `qt6ct` do nothing. The widget style
# is set inside qt6ct.conf instead (currently Fusion, with the Catppuccin
# palette in qt6ct/colors/catppuccin-mocha.conf -- Kvantum ignores the palette
# and paints its own colours, which is why it is not used).

# ---- Input method (fcitx5, with mozc + pinyin) ----
#
# Note: /etc/environment already exports QT_IM_MODULE=fcitx system-wide, which
# is why it shows up in the session despite not being set here.
#
# Hyprland implements text-input-v3, so Wayland-native GTK and Qt apps talk to
# fcitx5 through the compositor and need no *_IM_MODULE variables. Setting
# GTK_IM_MODULE/QT_IM_MODULE here would force the older module path and is a
# common cause of doubled or dead-key input on Wayland.
#
# XWayland apps have no such protocol, so they still need XMODIFIERS.
export XMODIFIERS=@im=fcitx

# SDL and GLFW games/apps do their own thing; both want to be told explicitly.
# GLFW speaks the ibus protocol, which fcitx5 also implements.
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus

# If some specific XWayland GTK or Qt app refuses to compose, uncomment the
# matching line below -- but expect Wayland-native apps to get worse, not
# better, so prefer fixing it per-app:
# export GTK_IM_MODULE=fcitx
# export QT_IM_MODULE=fcitx

# ---- Per-machine ----
#
# The only templated part of this file. Everything above is the same on every
# machine.
{{ if eq .chezmoi.hostname "LAPTOP-ON9AU" }}
# ---- Hybrid graphics: run the compositor on the iGPU only ----
#
# This laptop has an Intel Arc 140T (PCI 00:02.0) and an NVIDIA RTX PRO 2000
# (PCI 01:00.0). Every display connector -- the panel, HDMI, USB-C -- is wired
# to the Intel side; the NVIDIA card has no outputs at all and exists for
# render offload. Listing only the iGPU here means the compositor never opens
# the NVIDIA card, so it can runtime-suspend to D3cold instead of idling at a
# few watts all session. Check it is actually asleep with:
#
#   cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status   # -> suspended
#
# Use `prime-run <program>` for anything that wants the NVIDIA card; that wakes
# it on demand.
#
# This has to be set before the compositor starts, which is why it is here and
# not in hypr/env.lua -- hl.env() only reaches processes Hyprland itself spawns,
# and by then aquamarine has already picked its devices.
#
# The by-path symlink, NOT /dev/dri/card0 or card1: which minor each driver
# gets is decided by init timing on this machine and has already changed once
# across a kernel update. The PCI address does not move.
#
# Do NOT add GBM_BACKEND or __GLX_VENDOR_LIBRARY_NAME here. Those are for the
# opposite arrangement -- NVIDIA driving the display -- and would break this
# one.
export AQ_DRM_DEVICES=/dev/dri/by-path/pci-0000:00:02.0-card

# Steam is not installed on this machine. Kept so that installing it does not
# come with a mystery: with xwayland.force_zero_scaling (see hypr/xwayland.lua)
# Steam renders at the native 3840x2400 and stays sharp but draws its UI at
# 1:1, so it needs telling to scale itself by the same 2 the panel uses.
export STEAM_FORCE_DESKTOPUI_SCALING=2
{{- else }}
# Single-GPU machine: no AQ_DRM_DEVICES needed, aquamarine picks the only card.

# Steam is X11-only and has no Wayland backend. With
# xwayland.force_zero_scaling (see hypr/xwayland.lua) it renders at native 4K
# and stays sharp, but draws its UI at 1:1 and so comes out small -- this tells
# it to scale itself, matching the 1.25 scale of the primary monitor.
export STEAM_FORCE_DESKTOPUI_SCALING=1.25
{{- end }}

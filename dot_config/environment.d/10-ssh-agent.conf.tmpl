# Point the whole user session at OpenSSH's agent.
#
# Arch's ssh-agent.socket listens on %t/ssh-agent.socket but exports nothing;
# its own unit file says "Requires SSH_AUTH_SOCK=... to be set in environment".
# Until something sets it, SSH_AUTH_SOCK is either unset or -- on this machine,
# left over from when gcr-ssh-agent.socket was enabled -- still naming
# /run/user/1000/gcr/ssh, a socket with nothing behind it.
#
# gcr-ssh-agent is retired here rather than fixed: it links no libfido2 and
# knows no sk-* key types, so it cannot carry the YubiKey FIDO2 keys
# (~/.ssh/id_ed25519_sk_*). Keep gcr-ssh-agent.socket disabled -- if it is
# re-enabled it sets this variable again at login and wins.
#
# Read by the systemd user manager at login, so it reaches graphical apps
# (editors, browsers, anything uwsm or XDG-autostart launches). Interactive
# shells get the same value from .zshrc, which is the half that also covers
# SSHing *into* this machine, where nothing reads environment.d.
#
# NOT the same socket name everywhere, so it is chosen at apply time: Arch's
# ssh-agent.socket listens on %t/ssh-agent.socket, while NixOS's
# programs.ssh.startAgent runs the agent with `-a %t/ssh-agent`.
#
# Keep the file, though. The module does export SSH_AUTH_SOCK, but it does it
# through environment.extraInit -- which is /etc/profile, so it reaches shells
# and nothing else -- and only when the variable is not already set:
#
#   if [ -z "$SSH_AUTH_SOCK" -a -n "$XDG_RUNTIME_DIR" ]; then
#       export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent"
#   fi
#
# It never reaches the systemd user manager, which is precisely the half this
# file exists to cover. So on NixOS this is not redundant -- it is the only
# thing setting the variable for graphical apps, and deleting it would break
# them while shells carried on working, which is the confusing direction.
#
# (An earlier version of this comment said to delete the file on NixOS. That
# was wrong: it read "the module exports it" and stopped before checking which
# environment the module exports it *into*.)
#
# `get .chezmoi.osRelease "id"` rather than the dotted .chezmoi.osRelease.id,
# because on a machine with no /etc/os-release -- macOS -- osRelease is an
# empty map and the dotted form is a hard template error:
#
#   executing "arg1" at <.chezmoi.osRelease.id>: map has no entry for key "id"
#
# `get` returns "" there instead. This file is ignored on darwin, but a
# template that cannot be evaluated breaks the apply before anything gets as
# far as deciding to ignore it.
{{ if eq (get .chezmoi.osRelease "id") "nixos" -}}
SSH_AUTH_SOCK=${XDG_RUNTIME_DIR}/ssh-agent
{{- else -}}
SSH_AUTH_SOCK=${XDG_RUNTIME_DIR}/ssh-agent.socket
{{- end }}

# ssh-agent is a systemd unit, so it has no tty and can only ask for a FIDO2
# PIN through an askpass helper. Unset, it tries /usr/lib/ssh/ssh-askpass --
# packaged only in x11-ssh-askpass -- and every signing request fails with
# "agent refused operation" on the client and the misleading "incorrect
# passphrase supplied to decrypt private key" in its own journal.
#
# This has to be here rather than only in uwsm/env: uwsm sets the graphical
# session's environment, but the user manager starts ssh-agent from its own,
# which is what environment.d feeds.
#
# The path used to be written out as /usr/bin/ksshaskpass, which is an Arch
# path to an Arch package -- anywhere else it names a helper that is not there,
# and the prompt it exists to raise silently never happens. But environment.d
# is KEY=VALUE, not shell: it cannot look anything up at runtime the way
# uwsm/env now does. So the lookup happens at `chezmoi apply` time instead,
# over the same preference list, and the absolute path of whatever this machine
# actually has is baked in. That is the whole reason this file is a template.
#
# Consequence worth knowing: install the askpass helper *before* applying, and
# re-apply after changing which one is installed.
{{ $askpass := "" -}}
{{ range (list "ksshaskpass" "lxqt-openssh-askpass" "ssh-askpass-fullscreen" "ssh-askpass") -}}
{{   if and (eq $askpass "") (lookPath .) }}{{ $askpass = lookPath . }}{{ end -}}
{{ end -}}
{{ if $askpass }}
SSH_ASKPASS={{ $askpass }}
{{- else }}
# Nothing from that list was on PATH when this was applied, so SSH_ASKPASS is
# left unset rather than pointed at a helper that does not exist. Install one
# (ksshaskpass, lxqt-openssh-askpass, ...) and re-run `chezmoi apply`.
{{- end }}

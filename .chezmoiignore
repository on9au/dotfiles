# macOS: same shell/tmux/nvim half as WSL, none of the Wayland compositor
# half. Everything below is Hyprland/waybar/uwsm/KDE/XDG-portal config that
# has nothing to read it on macOS, plus .local/bin, which is entirely
# wrappers around hyprctl/wl-copy/fuzzel/loginctl.
#
# kitty is in this list too: this machine uses Ghostty instead, specifically
# for background-blur, which kitty does not support on macOS. Linux/Hyprland
# keeps kitty -- see dot_config/ghostty/config and dot_config/kitty/kitty.conf.
{{ if eq .chezmoi.os "darwin" }}
.config/autostart
.config/environment.d
.config/fuzzel
.config/hypr
.config/kcminputrc
.config/kitty
.config/mimeapps.list
.config/qt6ct
.config/spotify-launcher.conf
.config/swaync
.config/uwsm
.config/waybar
.config/winapps
.config/xdg-desktop-portal
.local/bin
.local/share/dbus-1
{{ end }}

# Ghostty, AeroSpace, SketchyBar and JankyBorders are macOS-only here -- the
# closest analog stack to Hyprland/waybar this OS has (no Wayland, so no
# literal port is possible). Nothing on Linux/Windows reads any of these.
#
# Karabiner and the key-repeat script join them for the same reason: Karabiner
# is the Caps Lock -> hyper remap that gives AeroSpace the single-key mod
# SUPER already is on Linux, and darwin-key-repeat.sh is the NSGlobalDomain
# half of hypr/input.lua's repeat_rate/repeat_delay. Both are macOS-only by
# construction -- Linux does the first in kb_options and the second in
# input.lua directly.
{{ if ne .chezmoi.os "darwin" }}
.config/ghostty
.config/aerospace
.config/sketchybar
.config/borders
.config/karabiner
darwin-key-repeat.sh
{{ end }}

.config/qt6ct
.config/spotify-launcher.conf
.config/swaync
.config/uwsm
.config/waybar
.config/winapps
.config/xdg-desktop-portal
.local/bin
.local/share/dbus-1
.tmux
.tmux.conf
.zsh_plugins.txt
.zshenv
.zshrc
reload-hyprland.sh
{{ end }}

{{ if ne .chezmoi.os "windows" }}
.glzr
{{ end }}


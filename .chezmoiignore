.config/nvim/.git

# KDE rewrites this constantly and it holds machine-specific state (Xwayland
# Scale, per-output Tiling UUIDs), so it drifted on every `chezmoi status`.
.config/kwinrc

# Root-owned system config kept in this repo for reference (greetd lives in
# /etc, which chezmoi does not manage). Without this, chezmoi would try to
# create ~/system/greetd/... since every path here is relative to $HOME.
system

# Prose, not dotfiles -- hardware/OS investigations worth not repeating. Same
# reason as `system` above: without this, chezmoi would create ~/docs/.
docs

# ---------------------------------------------------------------------------
# Per-OS targets.
#
# This repo is a Linux/Hyprland setup that now also lands on a Windows work
# laptop (G3JC7G4, GlazeWM instead of Hyprland). Without these guards
# `chezmoi apply` there writes zsh, tmux and twenty hypr/*.lua files into a
# profile where nothing reads them -- and applying on Linux would create a
# stray ~/.glzr for a window manager that does not exist.
#
# WSL is the third case: it wants the shell half (zsh, tmux, nvim) and none of
# the compositor half, since the desktop is Windows. Detected on the kernel
# release string rather than a hostname, so it holds for any distro.
# ---------------------------------------------------------------------------

{{ if eq .chezmoi.os "windows" }}
.config/autostart
.config/environment.d
.config/fuzzel
.config/hypr
.config/kcminputrc
.config/kitty
